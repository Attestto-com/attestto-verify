{
  "name": "@attestto/verify",
  "version": "0.1.2",
  "description": "Web Components for document verification and signing — verify.attestto.com",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/attestto-verify.js",
  "module": "dist/attestto-verify.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/attestto-verify.js",
      "types": "./dist/index.d.ts"
    },
    "./verify": {
      "import": "./dist/components/attestto-verify.js"
    },
    "./sign": {
      "import": "./dist/components/attestto-sign.js"
    },
    "./plugins/did-verifier": {
      "import": "./dist/plugins/did-verifier.js"
    }
  },
  "keywords": [
    "document-verification",
    "digital-signatures",
    "web-components",
    "pdf-verification",
    "pades",
    "pkcs7",
    "did",
    "verifiable-credentials",
    "pki",
    "forensic-audit",
    "client-side",
    "zero-trust",
    "attestto"
  ],
  "homepage": "https://verify.attestto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Attestto-com/attestto-verify.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.build.json",
    "build:pages": "vite build --config vite.config.pages.ts",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "gate-self-test": "node scripts/gate-self-test.mjs"
  },
  "dependencies": {
    "@attestto/id-wallet-adapter": "^0.7.0",
    "asn1js": "^3.0.10",
    "lit": "^3.3.3",
    "pdf-lib": "^1.17.1",
    "pkijs": "^3.4.0",
    "pvutils": "^1.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.1.5",
    "vitest": "^3.2.7"
  },
  "author": "Eduardo Chongkan <eduardo@attestto.com>",
  "contributors": [
    "Guillermo Chavarria <guillermocc@attestto.com>"
  ],
  "gateSelfTest": {
    "workflow": ".github/workflows/ci.yml",
    "testScript": "test",
    "buildScript": "build",
    "gates": [
      {
        "name": "lint",
        "script": "lint",
        "seed": "src/__gate-self-test__.ts",
        "content": "export function seeded(): void {\n  const unused = 1\n}\n"
      },
      {
        "name": "test",
        "script": "test",
        "seed": "src/__gate-self-test__.spec.ts",
        "content": "import { it, expect } from 'vitest'\nit('is a deliberate failure', () => { expect(1).toBe(2) })\n"
      }
    ]
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23 <9",
      "js-yaml": ">=4.3.1 <5"
    }
  }
}
